# Секреты только здесь, этот файл копируется в .env и не попадает в Git.
BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
# Если Bot API с TELEGRAM_LOCAL=1.
TELEGRAM_API_BASE=http://127.0.0.1:8081
TELEGRAM_MAX_FILE_MB=1900
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Пути относительно components-backup/, UTC. Пустое время отключает ежедневный запуск.
BACKUP_DATA_DIR=./data
BACKUP_TIME_UTC=02:00
BACKUP_KEEP=14
