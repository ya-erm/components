# ───────────────────────── Аутентификация (Auth.js v5) ──────────────────────
# Сгенерировать: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-random-32-byte-string"
# Базовый URL приложения (на Vercel выставляется автоматически; локально не обязателен)
# AUTH_URL="http://localhost:3000"

# ───────────────────────── S3-совместимое хранилище ─────────────────────────
# Локально — MinIO из docker-compose. В проде — AWS S3 / Yandex Cloud Object Storage.
# Изображения сохраняются под публичным префиксом public/images/ (см. lib/s3.ts);
# публичный доступ на чтение должен быть открыт ТОЛЬКО на префикс public/* (bucket policy),
# остальное (напр. users/*) — приватно.
S3_ENDPOINT="http://localhost:9000"     # AWS: оставить пустым; YC: https://storage.yandexcloud.net
S3_REGION="us-east-1"                    # YC: ru-central1
S3_BUCKET="components"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Нужно для MinIO/YC и большинства S3-совместимых хранилищ (path-style URL).
# Для нативного AWS S3 поставить "false".
S3_FORCE_PATH_STYLE="true"
# Публичный базовый URL бакета (без слеша в конце); к нему добавляется ключ объекта.
# Локально (MinIO): http://localhost:9000/components
# YC: https://storage.yandexcloud.net/<bucket>
S3_PUBLIC_URL="http://localhost:9000/components"
